/* sir9 TUI Styles */
Screen {
    layout: vertical;
}

#main_content {
    width: 100%;
    height: 100%;
    padding: 1 2;
    content-align: center middle;
}

#title {
    text-align: center;
    text-style: bold;
    color: $primary;
    padding: 1;
}

#brand {
    text-align: center;
    color: $text-muted;
    padding: 0 1 2 1;
}

#content {
    padding: 1 2;
    background: $surface;
    border: solid $primary;
    margin: 1 2;
    height: auto;
    max-height: 20;
    overflow-y: auto;
}

#start_btn {
    margin: 1 2;
    width: auto;
    min-width: 20;
}

#quiz_btn {
    margin: 1 2;
    width: auto;
    min-width: 20;
}

#btn_row {
    height: auto;
    align-horizontal: center;
    margin: 1 2;
}

#btn_row Button {
    margin: 0 1;
}

#status_bar {
    dock: bottom;
    width: 100%;
    height: 1;
    background: $surface;
    color: $text;
    padding: 0 2;
    content-align: left middle;
}
